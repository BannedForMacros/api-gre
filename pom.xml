<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 2.7.x es la ULTIMA rama de Spring Boot que corre en Java 8.
             Boot 3 exige Java 17, que no es seguro en Windows 7. -->
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>pe.dbperu</groupId>
    <artifactId>api-gre</artifactId>
    <version>1.0.0</version>
    <name>ApiGRE</name>
    <description>API de Guias de Remision Electronicas. Unico canal hacia el DataMart.</description>

    <properties>
        <!-- Java 8: minimo comun denominador de Windows 7 / Server 2008 R2.
             Java 11+ deja de estar soportado oficialmente en Windows 7. -->
        <java.version>8</java.version>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Driver SQL Server compatible con Java 8 y SQL Server 2008 -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>7.4.1.jre8</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>api-gre</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- fat JAR con Tomcat embebido: se instala copiando UN archivo.
                         Sin Tomcat que administrar en casa del cliente. -->
                    <executable>false</executable>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
